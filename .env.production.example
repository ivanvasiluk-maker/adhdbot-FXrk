APP_ENV=production
BOT_TOKEN=production-telegram-bot-token
OPENAI_API_KEY=
DB_PATH=data/skiller-production.db
PAYMENT_ACCEPT_ANY=0
FREE_BETA_ACCESS=1
PAYMENT_URL=
# Enable only after PAYMENT_URL points to the verified production provider.
ENABLE_PAYMENTS=0
ENABLE_DAY1_WOW=true
ENABLE_HUMAN_OFFER=true
ENABLE_GROUP_OFFER=true
ENABLE_PAID_PLAN=false
HUMAN_SKILL_SESSION_EUR=39
GROUP_SESSION_EUR_MIN=30
GROUP_SESSION_EUR_MAX=30
GROUP_SESSION_COUNT=8
TEST_MODE=0
TEST_CHEAT_CODE=
INTERNAL_TEST_USER_IDS=
ADMIN_IDS=
# Sheets export is opt-in and requires a private, rotated salt.
SHEETS_WEBHOOK_URL=
SHEETS_SYNC_ENABLED=false
ANALYTICS_ID_SALT=
# New architecture remains cohort-only until its Telegram E2E gate is green.
NEW_ARCHITECTURE_ENABLED=false
NEW_ARCHITECTURE_TEST_COHORT_ENABLED=true
NEW_ARCHITECTURE_COHORT_IDS=
LEARNING_ENGINE_ENABLED=false
RANKING_ENGINE_ENABLED=false
SKILL_REGISTRY_ENABLED=0
SKILLER_ACTION_ROUTER_ENABLED=false
